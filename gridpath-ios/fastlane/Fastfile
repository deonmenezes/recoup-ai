default_platform(:ios)

# GridPath iOS — mirrors the proven TechScroll signing recipe (fastlane + ASC API key).
KEY_ID    = "PKRJR56447"
ISSUER_ID = "cacd4f89-0613-479c-ac4d-09ffea7d7a45"
KEY_PATH  = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_PKRJR56447.p8")
APP_ID    = "com.deonmenezes.gridpath"
TEAM_ID   = "Q4MU4GRWRD"
PROFILE   = "GridPath AppStore"
# Valid keychain distribution identity (team is at the 2-cert limit — reuse it, don't mint).
CERT_ID   = "USCKLYK64F"

platform :ios do
  desc "Regenerate the Xcode project from project.yml"
  lane :gen do
    Dir.chdir("..") { sh("xcodegen generate") }
  end

  desc "Archive with App Store signing (API key) and upload to TestFlight"
  lane :beta do
    Dir.chdir("..") { sh("xcodegen generate") }

    api_key = app_store_connect_api_key(
      key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH
    )

    # Pin a provisioning profile to the existing distribution cert. `cert` is
    # intentionally skipped (team at 2-cert limit). Requires the app record +
    # bundle ID to already exist — run `fastlane produce` first (see README).
    sigh(
      api_key: api_key,
      app_identifier: APP_ID,
      team_id: TEAM_ID,
      provisioning_name: PROFILE,
      cert_id: CERT_ID,
      force: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "GridPath.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: PROFILE,
      targets: ["GridPath"]
    )

    build_app(
      project: "GridPath.xcodeproj",
      scheme: "GridPath",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "GridPath.ipa",
      export_options: { provisioningProfiles: { APP_ID => PROFILE } }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Show TestFlight build state + beta groups + testers"
  lane :tf_info do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    builds = app.get_builds(sort: "-uploadedDate", limit: 3)
    builds.each { |b| UI.message("BUILD v#{b.version} state=#{b.processing_state} uploaded=#{b.uploaded_date}") }
    app.get_beta_groups.each do |g|
      UI.message("GROUP name=#{g.name} internal=#{g.is_internal_group} id=#{g.id}")
    end
  end

  desc "Create internal group, add tester, attach latest build (raw ASC API)"
  lane :distribute do |options|
    require "jwt"; require "json"; require "net/http"; require "uri"; require "openssl"
    email = options[:email] || "deonmenezes04@gmail.com"
    key = OpenSSL::PKey::EC.new(File.read(KEY_PATH))
    now = Time.now.to_i
    jwt = JWT.encode({ iss: ISSUER_ID, iat: now, exp: now + 1000, aud: "appstoreconnect-v1" },
                     key, "ES256", { kid: KEY_ID, typ: "JWT" })
    base = "https://api.appstoreconnect.apple.com/v1"
    call = lambda do |method, path, body = nil|
      uri = URI(path.start_with?("http") ? path : "#{base}/#{path}")
      klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }[method]
      req = klass.new(uri)
      req["Authorization"] = "Bearer #{jwt}"; req["Content-Type"] = "application/json"
      req.body = body.to_json if body
      res = Net::HTTP.start(uri.host, 443, use_ssl: true) { |h| h.request(req) }
      parsed = (res.body && !res.body.empty?) ? (JSON.parse(res.body) rescue { "raw" => res.body }) : {}
      [res.code.to_i, parsed]
    end

    appid = call.call(:get, "apps?filter[bundleId]=#{APP_ID}")[1].dig("data", 0, "id")
    UI.user_error!("App not found") unless appid

    buildrec = call.call(:get, "builds?filter[app]=#{appid}&sort=-uploadedDate&limit=1")[1].dig("data", 0)
    build_id = buildrec&.dig("id")
    UI.message("Build #{buildrec&.dig('attributes','version')} state=#{buildrec&.dig('attributes','processingState')} id=#{build_id}")

    # Find or create an internal group (only name + isInternalGroup — avoids the public-link bug).
    groups = call.call(:get, "apps/#{appid}/betaGroups")[1]["data"] || []
    gid = groups.find { |g| g.dig("attributes", "isInternalGroup") }&.dig("id")
    if gid
      UI.message("Existing internal group #{gid}")
    else
      code, body = call.call(:post, "betaGroups", { data: {
        type: "betaGroups", attributes: { name: "Internal Testers", isInternalGroup: true },
        relationships: { app: { data: { type: "apps", id: appid } } }
      } })
      gid = body.dig("data", "id")
      UI.message("Created internal group #{gid} (#{code})")
    end
    UI.user_error!("No group") unless gid

    # Attach build to group.
    code, _ = call.call(:post, "betaGroups/#{gid}/relationships/builds", { data: [{ type: "builds", id: build_id }] })
    UI.message("Attach build -> #{code}")

    # Add internal tester.
    code, body = call.call(:post, "betaTesters", { data: {
      type: "betaTesters", attributes: { email: email, firstName: "Deon", lastName: "Menezes" },
      relationships: { betaGroups: { data: [{ type: "betaGroups", id: gid }] } }
    } })
    UI.message("Add tester #{email} -> #{code}")
    UI.error(body.to_json[0, 300]) unless [200, 201].include?(code)
    UI.success("DISTRIBUTE_DONE group=#{gid} build=#{build_id}")
  end

  desc "Deliver the latest build to a tester: internal if they're a team user, else external group + beta review"
  lane :verify_tester do |options|
    require "jwt"; require "json"; require "net/http"; require "uri"; require "openssl"
    email = options[:email] || "deonmenezes04@gmail.com"
    key = OpenSSL::PKey::EC.new(File.read(KEY_PATH))
    now = Time.now.to_i
    jwt = JWT.encode({ iss: ISSUER_ID, iat: now, exp: now + 1000, aud: "appstoreconnect-v1" },
                     key, "ES256", { kid: KEY_ID, typ: "JWT" })
    base = "https://api.appstoreconnect.apple.com/v1"
    call = lambda do |method, path, body = nil|
      uri = URI(path.start_with?("http") ? path : "#{base}/#{path}")
      klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }[method]
      req = klass.new(uri); req["Authorization"] = "Bearer #{jwt}"; req["Content-Type"] = "application/json"
      req.body = body.to_json if body
      res = Net::HTTP.start(uri.host, 443, use_ssl: true) { |h| h.request(req) }
      [res.code.to_i, (res.body && !res.body.empty?) ? (JSON.parse(res.body) rescue {}) : {}]
    end
    appid = call.call(:get, "apps?filter[bundleId]=#{APP_ID}")[1].dig("data", 0, "id")
    builds = call.call(:get, "builds?filter[app]=#{appid}&sort=-uploadedDate&limit=4")[1]["data"] || []
    latest = builds.first; bid = latest&.dig("id")
    UI.message("LATEST BUILD v#{latest&.dig('attributes','version')} state=#{latest&.dig('attributes','processingState')} id=#{bid}")

    # Is the email an App Store Connect team user (eligible for internal testing)?
    users = call.call(:get, "users?filter[username]=#{URI.encode_www_form_component(email)}")[1]["data"] || []
    is_team_user = !users.empty?
    UI.message("TEAM_USER=#{is_team_user}")

    # Existing global tester id, if any
    tbody = call.call(:get, "betaTesters?filter[email]=#{URI.encode_www_form_component(email)}")[1]
    existing_tid = (tbody["data"] || []).first&.dig("id")

    if is_team_user
      gid = (call.call(:get, "apps/#{appid}/betaGroups")[1]["data"] || []).find { |g| g.dig("attributes", "isInternalGroup") }&.dig("id")
      call.call(:post, "betaGroups/#{gid}/relationships/builds", { data: [{ type: "builds", id: bid }] })
      # List who is ALREADY in the internal group
      members = call.call(:get, "betaGroups/#{gid}/betaTesters?limit=200")[1]["data"] || []
      emails = members.map { |m| m.dig("attributes", "email") }
      UI.message("INTERNAL_GROUP_MEMBERS(#{emails.size}): #{emails.join(', ')}")
      already = emails.map { |e| e.to_s.downcase }.include?(email.downcase)
      if already
        UI.success("ALREADY_INTERNAL_TESTER #{email}")
      elsif existing_tid
        c, rb = call.call(:post, "betaGroups/#{gid}/relationships/betaTesters", { data: [{ type: "betaTesters", id: existing_tid }] })
        UI.message("INTERNAL add existing -> #{c}")
        UI.error(rb.to_json[0,250]) unless [200,201,204].include?(c)
      else
        c, _ = call.call(:post, "betaTesters", { data: { type: "betaTesters", attributes: { email: email, firstName: "Deon", lastName: "Menezes" },
          relationships: { betaGroups: { data: [{ type: "betaGroups", id: gid }] } } } })
        UI.message("INTERNAL create -> #{c}")
      end
      UI.success("DELIVERED_INTERNAL build=#{bid} group=#{gid}")
    else
      # External path: find/create an external group, add tester, attach build, submit for beta review.
      groups = call.call(:get, "apps/#{appid}/betaGroups")[1]["data"] || []
      ext = groups.find { |g| !g.dig("attributes", "isInternalGroup") }
      egid = ext&.dig("id")
      unless egid
        c, b = call.call(:post, "betaGroups", { data: { type: "betaGroups",
          attributes: { name: "External Testers", isInternalGroup: false },
          relationships: { app: { data: { type: "apps", id: appid } } } } })
        egid = b.dig("data", "id"); UI.message("CREATE external group -> #{c} id=#{egid}")
      else
        UI.message("EXTERNAL group exists id=#{egid}")
      end
      call.call(:post, "betaGroups/#{egid}/relationships/builds", { data: [{ type: "builds", id: bid }] })
      if existing_tid
        c, _ = call.call(:post, "betaGroups/#{egid}/relationships/betaTesters", { data: [{ type: "betaTesters", id: existing_tid }] })
        UI.message("EXTERNAL add existing tester -> #{c}")
      else
        c, rb = call.call(:post, "betaTesters", { data: { type: "betaTesters", attributes: { email: email, firstName: "Deon", lastName: "Menezes" },
          relationships: { betaGroups: { data: [{ type: "betaGroups", id: egid }] } } } })
        UI.message("EXTERNAL create tester -> #{c}")
        UI.error(rb.to_json[0,200]) unless [200,201].include?(c)
      end
      # Submit the build for Beta App Review (required before external testers can install).
      c, rb = call.call(:post, "betaAppReviewSubmissions", { data: { type: "betaAppReviewSubmissions",
        relationships: { build: { data: { type: "builds", id: bid } } } } })
      UI.message("BETA_REVIEW_SUBMIT -> #{c}")
      UI.error(rb.to_json[0,250]) unless [200,201].include?(c)
      UI.success("DELIVERED_EXTERNAL build=#{bid} group=#{egid} (pending Apple beta review)")
    end
  end

  # Shared raw-ASC-API helper: returns a lambda [code, parsed] for a given method/path/body.
  def asc_client
    require "jwt"; require "json"; require "net/http"; require "uri"; require "openssl"; require "digest"
    key = OpenSSL::PKey::EC.new(File.read(KEY_PATH))
    base = "https://api.appstoreconnect.apple.com/v1"
    lambda do |method, path, body = nil|
      now = Time.now.to_i
      jwt = JWT.encode({ iss: ISSUER_ID, iat: now, exp: now + 1100, aud: "appstoreconnect-v1" }, key, "ES256", { kid: KEY_ID, typ: "JWT" })
      uri = URI(path.start_with?("http") ? path : "#{base}/#{path}")
      klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch, put: Net::HTTP::Put, delete: Net::HTTP::Delete }[method]
      r = klass.new(uri); r["Authorization"] = "Bearer #{jwt}"; r["Content-Type"] = "application/json"
      r.body = body.is_a?(String) ? body : body.to_json if body
      res = Net::HTTP.start(uri.host, 443, use_ssl: true) { |h| h.request(r) }
      [res.code.to_i, (res.body && !res.body.empty?) ? (JSON.parse(res.body) rescue { "raw" => res.body[0, 300] }) : {}]
    end
  end

  desc "Raw-API prep: attach latest VALID build, content rights, age rating (4+), upload screenshots"
  lane :finalize_appstore do
    require "digest"
    api = asc_client
    appid = api.call(:get, "apps?filter[bundleId]=#{APP_ID}")[1].dig("data", 0, "id")
    ver = api.call(:get, "apps/#{appid}/appStoreVersions?filter[appStoreState]=PREPARE_FOR_SUBMISSION&limit=1")[1].dig("data", 0)
    verid = ver && ver["id"]
    UI.user_error!("No editable version") unless verid
    UI.message("APP #{appid} VERSION #{verid}")

    build = api.call(:get, "builds?filter[app]=#{appid}&filter[processingState]=VALID&sort=-uploadedDate&limit=1")[1].dig("data", 0)
    if build
      c, _ = api.call(:patch, "appStoreVersions/#{verid}/relationships/build", { data: { type: "builds", id: build["id"] } })
      UI.message("ATTACH build v#{build.dig('attributes','version')} -> #{c}")
    end

    c, b = api.call(:patch, "apps/#{appid}", { data: { type: "apps", id: appid, attributes: { contentRightsDeclaration: "DOES_NOT_USE_THIRD_PARTY_CONTENT" } } })
    UI.message("CONTENT_RIGHTS -> #{c}"); UI.error(b.to_json[0, 200]) unless c == 200

    incl = api.call(:get, "appStoreVersions/#{verid}?include=ageRatingDeclaration")
    ardid = incl[1].dig("data", "relationships", "ageRatingDeclaration", "data", "id") ||
            (incl[1]["included"] || []).find { |x| x["type"] == "ageRatingDeclarations" }&.dig("id")
    UI.message("AGE id=#{ardid}")
    attrs = { alcoholTobaccoOrDrugUseOrReferences: "NONE", contests: "NONE", gamblingSimulated: "NONE",
              medicalOrTreatmentInformation: "NONE", profanityOrCrudeHumor: "NONE", sexualContentGraphicAndNudity: "NONE",
              sexualContentOrNudity: "NONE", horrorOrFearThemes: "NONE", matureOrSuggestiveThemes: "NONE",
              unrestrictedWebAccess: false, gambling: false, violenceCartoonOrFantasy: "NONE",
              violenceRealistic: "NONE", violenceRealisticProlongedGraphicOrSadistic: "NONE", lootBox: false }
    c, b = api.call(:patch, "ageRatingDeclarations/#{ardid}", { data: { type: "ageRatingDeclarations", id: ardid, attributes: attrs } })
    UI.message("AGE_RATING(#{ardid}) -> #{c}"); UI.error(b.to_json[0, 400]) unless c == 200

    loc = api.call(:get, "appStoreVersions/#{verid}/appStoreVersionLocalizations?filter[locale]=en-US")[1].dig("data", 0)
    locid = loc && loc["id"]
    shots = Dir[File.join(File.dirname(__FILE__), "screenshots", "en-US", "*.png")].sort
    UI.message("LOC #{locid} shots=#{shots.size}")
    if locid && !shots.empty?
      dt = "APP_IPHONE_67"
      sets = api.call(:get, "appStoreVersionLocalizations/#{locid}/appScreenshotSets")[1]["data"] || []
      setid = sets.find { |s| s.dig("attributes", "screenshotDisplayType") == dt }&.dig("id")
      unless setid
        c, b = api.call(:post, "appScreenshotSets", { data: { type: "appScreenshotSets", attributes: { screenshotDisplayType: dt },
          relationships: { appStoreVersionLocalization: { data: { type: "appStoreVersionLocalizations", id: locid } } } } })
        setid = b.dig("data", "id"); UI.message("SET #{dt} -> #{c} id=#{setid}"); UI.error(b.to_json[0, 300]) unless setid
      end
      # Idempotent: clear any existing screenshots in the set before uploading the 3.
      existing = api.call(:get, "appScreenshotSets/#{setid}/appScreenshots?limit=20")[1]["data"] || []
      existing.each { |sc| api.call(:delete, "appScreenshots/#{sc['id']}") }
      UI.message("CLEARED #{existing.size} existing screenshots")
      shots.each do |path|
        bytes = File.binread(path); fname = File.basename(path)
        c, b = api.call(:post, "appScreenshots", { data: { type: "appScreenshots", attributes: { fileName: fname, fileSize: bytes.bytesize },
          relationships: { appScreenshotSet: { data: { type: "appScreenshotSets", id: setid } } } } })
        sid = b.dig("data", "id"); ops = b.dig("data", "attributes", "uploadOperations") || []
        UI.message("RESERVE #{fname} -> #{c} ops=#{ops.size}"); (UI.error(b.to_json[0, 300]); next) unless sid
        ops.each do |op|
          uri = URI(op["url"]); r = Net::HTTP::Put.new(uri); (op["requestHeaders"] || []).each { |h| r[h["name"]] = h["value"] }
          r.body = bytes[(op["offset"] || 0), (op["length"] || bytes.bytesize)]
          res = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https") { |h| h.request(r) }
          UI.message("  PUT -> #{res.code}")
        end
        c2, b2 = api.call(:patch, "appScreenshots/#{sid}", { data: { type: "appScreenshots", id: sid, attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } } })
        UI.message("COMMIT #{fname} -> #{c2}"); UI.error(b2.to_json[0, 200]) unless c2 == 200
      end
    end
    UI.success("FINALIZE_DONE version=#{verid}")
  end

  desc "Set the app age rating to 4+ via the fastlane update_app_age_rating action (new ASC age-rating API)"
  lane :age_rating do
    api_key = app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH)
    cfg = ["age_rating.json", "fastlane/age_rating.json"].find { |p| File.exist?(p) } || "age_rating.json"
    update_app_age_rating(
      api_key: api_key,
      app_identifier: APP_ID,
      age_rating_config_path: cfg
    )
  end

  desc "Raw-API: set the age-rating declaration (4+, all None) via the live relationship id"
  lane :set_age_rating do
    api = asc_client
    appid = api.call(:get, "apps?filter[bundleId]=#{APP_ID}")[1].dig("data", 0, "id")
    verid = api.call(:get, "apps/#{appid}/appStoreVersions?filter[appStoreState]=PREPARE_FOR_SUBMISSION&limit=1")[1].dig("data", 0, "id")
    rel = api.call(:get, "appStoreVersions/#{verid}/relationships/ageRatingDeclaration")
    UI.message("REL http=#{rel[0]} body=#{rel[1].to_json[0, 200]}")
    ardid = rel[1].dig("data", "id")
    UI.message("ardid=#{ardid}")
    return UI.error("No ageRatingDeclaration id from relationship") unless ardid
    attrs = { alcoholTobaccoOrDrugUseOrReferences: "NONE", contests: "NONE", gamblingSimulated: "NONE",
              medicalOrTreatmentInformation: "NONE", profanityOrCrudeHumor: "NONE", sexualContentGraphicAndNudity: "NONE",
              sexualContentOrNudity: "NONE", horrorOrFearThemes: "NONE", matureOrSuggestiveThemes: "NONE",
              unrestrictedWebAccess: false, gambling: false, violenceCartoonOrFantasy: "NONE",
              violenceRealistic: "NONE", violenceRealisticProlongedGraphicOrSadistic: "NONE", lootBox: false }
    c, b = api.call(:patch, "ageRatingDeclarations/#{ardid}", { data: { type: "ageRatingDeclarations", id: ardid, attributes: attrs } })
    UI.message("AGE PATCH -> #{c}"); UI.error(b.to_json[0, 500]) unless c == 200
    UI.success("AGE_SET ok") if c == 200
  end

  desc "Raw-API: create a review submission for the editable version and submit (surfaces blockers)"
  lane :submit_review do
    api = asc_client
    appid = api.call(:get, "apps?filter[bundleId]=#{APP_ID}")[1].dig("data", 0, "id")
    verid = api.call(:get, "apps/#{appid}/appStoreVersions?filter[appStoreState]=PREPARE_FOR_SUBMISSION&limit=1")[1].dig("data", 0, "id")
    # Clean up any prior unsubmitted review submissions to avoid clutter / conflicts.
    (api.call(:get, "reviewSubmissions?filter[app]=#{appid}&filter[state]=READY_FOR_REVIEW,UNRESOLVED_ISSUES,COMPLETING&limit=10")[1]["data"] || []).each do |rs|
      next if rs.dig("attributes", "submitted")
      dc, _ = api.call(:delete, "reviewSubmissions/#{rs['id']}")
      UI.message("cleanup reviewSubmission #{rs['id']} -> #{dc}")
    end
    c, b = api.call(:post, "reviewSubmissions", { data: { type: "reviewSubmissions", attributes: { platform: "IOS" }, relationships: { app: { data: { type: "apps", id: appid } } } } })
    rsid = b.dig("data", "id")
    UI.message("REVIEW_SUBMISSION -> #{c} id=#{rsid}")
    UI.error("CREATE: " + b.to_json[0, 500]) unless rsid
    return unless rsid
    c2, b2 = api.call(:post, "reviewSubmissionItems", { data: { type: "reviewSubmissionItems", relationships: { reviewSubmission: { data: { type: "reviewSubmissions", id: rsid } }, appStoreVersion: { data: { type: "appStoreVersions", id: verid } } } } })
    UI.message("ADD_ITEM -> #{c2}"); UI.error("ITEM: " + b2.to_json[0, 600]) unless [200, 201].include?(c2)
    c3, b3 = api.call(:patch, "reviewSubmissions/#{rsid}", { data: { type: "reviewSubmissions", id: rsid, attributes: { submitted: true } } })
    UI.message("SUBMIT -> #{c3}"); UI.error("SUBMIT: " + b3.to_json[0, 800]) unless c3 == 200
    UI.success("SUBMIT_DONE state=#{c3}") if c3 == 200
  end

  desc "Upload App Store metadata + screenshots to the editable version (no binary, no submit)"
  lane :upload_meta do
    api_key = app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH)
    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      sync_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots"
    )
  end

  desc "Dump App Store Connect state: app, versions+states, builds, agreements signal"
  lane :asc_status do
    require "jwt"; require "json"; require "net/http"; require "uri"; require "openssl"
    key = OpenSSL::PKey::EC.new(File.read(KEY_PATH)); now = Time.now.to_i
    jwt = JWT.encode({ iss: ISSUER_ID, iat: now, exp: now + 1000, aud: "appstoreconnect-v1" }, key, "ES256", { kid: KEY_ID, typ: "JWT" })
    base = "https://api.appstoreconnect.apple.com/v1"
    get = lambda do |path|
      uri = URI("#{base}/#{path}"); req = Net::HTTP::Get.new(uri); req["Authorization"] = "Bearer #{jwt}"
      res = Net::HTTP.start(uri.host, 443, use_ssl: true) { |h| h.request(req) }
      [res.code.to_i, (res.body && !res.body.empty?) ? (JSON.parse(res.body) rescue {}) : {}]
    end
    appid = get.call("apps?filter[bundleId]=#{APP_ID}")[1].dig("data", 0, "id")
    UI.message("APP id=#{appid}")
    info = get.call("apps/#{appid}")[1].dig("data", "attributes") || {}
    UI.message("APP name='#{info['name']}' sku=#{info['sku']} locale=#{info['primaryLocale']} contentRights=#{info['contentRightsDeclaration']}")
    vers = get.call("apps/#{appid}/appStoreVersions?limit=5")[1]["data"] || []
    UI.message("APP STORE VERSIONS (#{vers.size}):")
    vers.each { |v| a = v["attributes"]; UI.message("  v#{a['versionString']} state=#{a['appStoreState']} platform=#{a['platform']} created=#{a['createdDate']} id=#{v['id']}") }
    builds = get.call("builds?filter[app]=#{appid}&sort=-uploadedDate&limit=3")[1]["data"] || []
    UI.message("BUILDS:")
    builds.each { |b| a = b["attributes"]; UI.message("  v#{a['version']} state=#{a['processingState']} expired=#{a['expired']} id=#{b['id']}") }
    # availability / pricing signal
    code, _ = get.call("apps/#{appid}/appAvailabilityV2")
    UI.message("appAvailabilityV2 http=#{code}")
    UI.success("ASC_STATUS_DONE app=#{appid}")
  end

  desc "Build a signed .ipa only (no upload)"
  lane :build_only do
    Dir.chdir("..") { sh("xcodegen generate") }
    api_key = app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH)
    sigh(api_key: api_key, app_identifier: APP_ID, team_id: TEAM_ID,
         provisioning_name: PROFILE, cert_id: CERT_ID, force: true)
    update_code_signing_settings(
      use_automatic_signing: false, path: "GridPath.xcodeproj", team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution", bundle_identifier: APP_ID,
      profile_name: PROFILE, targets: ["GridPath"]
    )
    build_app(
      project: "GridPath.xcodeproj", scheme: "GridPath", configuration: "Release",
      export_method: "app-store", output_directory: "build", output_name: "GridPath.ipa",
      export_options: { provisioningProfiles: { APP_ID => PROFILE } }
    )
  end
end
